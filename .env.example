# Authentication
VITE_REQUIRE_BIOMETRICS=true

# n8n / Azure Function Webhook Endpoints
VITE_WEBHOOK_RESTART_PI_INTERFACE=https://your-n8n-server.com/webhook/restart-pi
VITE_WEBHOOK_SQL_DATA_SYNC=https://your-n8n-server.com/webhook/sql-sync
VITE_WEBHOOK_PYTHON_BACKFILL=https://your-n8n-server.com/webhook/python-backfill

# API Security Tokens (If required by your webhook gateway)
VITE_WEBHOOK_AUTH_BEARER_TOKEN=your_secure_placeholder_token
